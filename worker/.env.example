# Local settings for `npm run dev`. Copy to worker/.env (or worker/.dev.vars)
# and fill in the values. Never commit the copy.
# In production, set the secrets with `npx wrangler secret put <NAME>`.

# Secrets
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# https://admin.17track.net (leave the IP allow-list empty)
SEVENTEENTRACK_API_KEY=your-17track-api-key

# Cloudflare Access (production only; also set as secrets)
# Team domain from Zero Trust settings, AUD tag from the Access application.
ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
ACCESS_AUD=your-access-aud-tag

# Local only: skip Cloudflare Access and act as this user on localhost.
DEV_USER_EMAIL=dev@example.com

# Optional overrides of the [vars] in wrangler.toml
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# TIMEZONE=Asia/Manila
